{
  "name": "deposit-wars-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:perspective": "node tests/scene-play.mjs",
    "build:offline": "pnpm build && vite build --config vite.offline.config.ts && python scripts/build-offline-demo.py",
    "test:offline": "node tests/offline-demo.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
